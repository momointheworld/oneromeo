datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  id          String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  date     DateTime
  title    String
  slug     String    @unique
  categoryIDs String[]   @db.ObjectId
  categories  Category[] @relation(fields: [categoryIDs], references: [id])
  body     String
}

model Category {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  date    DateTime 
  postIDs String[] @db.ObjectId
  posts   Post[]   @relation(fields: [postIDs], references: [id])
}

// Define the Quiz model
model Quiz {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  date      DateTime
  quizName  String
  slug      String   @unique 
  questions Question[]
  results   Result[]  
  submissions  QuizSubmission[]  // Add this to track submissions

}

// Define the Question model
model Question {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  text     String
  answers  Answer[]
  quiz     Quiz    @relation(fields: [quizId], references: [id])
  quizId   String
}

// Define the Answer model with the new points field
model Answer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  text       String
  points     Int      // New field for points associated with each answer
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
}

// Define the Result model
model Result {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  minPoints Int     // Minimum points for this result
  maxPoints Int     // Maximum points for this result
  resultText String // Text description for this result
  quiz     Quiz    @relation(fields: [quizId], references: [id])
  quizId   String
}

// track submissions
model QuizSubmission {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId // MongoDB's default _id field
  quiz     Quiz     @relation(fields: [quizId], references: [id])
  quizId   String
  score    Int
  createdAt DateTime @default(now())
}

model Appointment {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  thDate       DateTime   // Date in Thai timezone (e.g., '2024-09-23')
  thTime       String     // Time in Thai timezone (24-hour format, e.g., '14:30')
  csrTimeZone  String     // Customer's timezone (e.g., 'America/New_York')
  csrDate      DateTime   // Date in customer's timezone (e.g., '2024-09-23')
  csrTime      String     // Time in customer's timezone (24-hour format, e.g., '02:30')
  utcDate      DateTime   // UTC date (e.g., '2024-09-23T00:00:00Z')
  utcTime      String     // UTC time in 24-hour format (e.g., '14:30')
  email        String     // Customer's email
  createdAt    DateTime   @default(now()) // Timestamp of when the appointment was created
}


model ProcessedEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId 
  eventId    String   @unique
  createdAt  DateTime
}

model Ebook {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  fileType  String
  uploadDate DateTime @default(now())
  fileSize  Int
}

model DownloadToken {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId 
  token          String   @unique
  email          String   @unique
  expirationDate DateTime
  createdAt      DateTime @default(now())
}

