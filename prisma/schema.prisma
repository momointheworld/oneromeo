datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  id          String @id @default(cuid()) @map("_id") // Add @map("_id") annotation
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  date     DateTime
  title    String
  slug     String    @unique
  categoryIDs String[]   @db.ObjectId
  categories  Category[] @relation(fields: [categoryIDs], references: [id])
  body     String
}

model Category {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  date    DateTime 
  postIDs String[] @db.ObjectId
  posts   Post[]   @relation(fields: [postIDs], references: [id])
}

// Define the Quiz model
model Quiz {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  date      DateTime
  quizName  String
  slug      String   @unique 
  quizDescription String  @default("No description provided")  // Set default value
  questions Question[]
  quizIcon       String    // Store the icon code
  results   Result[]  
  submissions  QuizSubmission[]  // Add this to track submissions
}

// Define the Question model
model Question {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  text     String
  answers  Answer[]
  quiz     Quiz    @relation(fields: [quizId], references: [id])
  quizId   String
}

// Define the Answer model with the new points field
model Answer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  text       String
  points     Int      // New field for points associated with each answer
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
}

// Define the Result model
model Result {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId // Using MongoDB's default _id field
  minPoints Int     // Minimum points for this result
  maxPoints Int     // Maximum points for this result
  resultText String // Text description for this result
  quiz     Quiz    @relation(fields: [quizId], references: [id])
  quizId   String
}

// track submissions
model QuizSubmission {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId // MongoDB's default _id field
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade) // Move the onDelete behavior here
  quizId   String
  score    Int
  createdAt DateTime @default(now())
}

model Appointment {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  thDate       String   // Date in Thai timezone (e.g., '2024-09-23')
  thTime       String     // Time in Thai timezone (24-hour format, e.g., '14:30')
  csrTimeZone  String     // Customer's timezone (e.g., 'America/New_York')
  csrDate      String   // Date in customer's timezone (e.g., '2024-09-23')
  csrTime      String     // Time in customer's timezone (24-hour format, e.g., '02:30')
  utcDate      String   // UTC date (e.g., '2024-09-23T00:00:00Z')
  utcTime      String     // UTC time in 24-hour format (e.g., '14:30')
  email        String     // Customer's email
  createdAt    DateTime   @default(now()) // Timestamp of when the appointment was created
}


model ProcessedEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId 
  eventId    String   @unique
  createdAt  DateTime
}

model Ebook {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  fileType  String
  uploadDate DateTime @default(now())
  fileSize  Int
}

model DownloadToken {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId 
  token          String   @unique
  email          String   @unique
  expirationDate DateTime
  createdAt      DateTime @default(now())
}

model ReviewLink {
  id            String   @id @default(cuid()) @map("_id") @db.ObjectId
  email         String   // Customer's email
  productId     String   // ID of the product purchased from Stripe
  productName   String   // Name of the product purchased
  token         String   @unique  // One-time token for the review link
  expiryDate    DateTime // Date when the review link expires (7 days)
  status        String   @default("pending") // Can be 'pending', 'sent', 'done'
  createdAt     DateTime @default(now()) // When the link was generated
  updatedAt     DateTime @updatedAt // When the link was last updated (if applicable)

  // Relation to Review: A ReviewLink is associated with a Review
  review        Review?  @relation("ReviewLinkToReview")

  // Relation to Customer: A ReviewLink is associated with a Customer
  customer      Customer @relation(fields: [email], references: [email])
}

model Product {
  id        String    @id @default(cuid()) @map("_id") @db.ObjectId
  name      String
  reviews   Review[]  @relation("ProductReviews") // Relation to Review model
}

model Review {
  id            String    @id @default(cuid()) @map("_id") @db.ObjectId
  email         String    // Email of the customer
  productId     String    // Reference to the product
  product       Product   @relation("ProductReviews", fields: [productId], references: [id]) // Product review relationship
  rating        Int       // Rating given by the customer
  comment       String    // Review comment
  submittedAt   DateTime  // Date when the review was first submitted
  updatedAt     DateTime  @updatedAt // Date when the review was last updated
  reviewLinkId  String    @unique  // Foreign key to ReviewLink
  editLinkToken String    @unique   // Unique token for the review link
  editLinkExpiry DateTime // Expiry date of the link
  isFinalized   Boolean   @default(false) // Flag to check if review is finalized
  status        String    @default("pending") // Review status: 'pending', 'approved', 'rejected'

  // Relation to ReviewLink: A Review is linked to a specific review link
  reviewLink    ReviewLink @relation("ReviewLinkToReview", fields: [reviewLinkId], references: [id])
}

model Customer {
  id            String   @id @default(cuid()) @map("_id") @db.ObjectId
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reviewLinks   ReviewLink[]
}
